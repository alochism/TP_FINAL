# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_base

# Clave para firmar los tokens JWT (usar un valor largo y aleatorio)
JWT_SECRET_KEY=tu_clave_secreta

# Origenes del frontend habilitados para CORS, separados por coma.
# Solo hace falta en produccion (ej. https://finanzas.vercel.app)
CORS_ORIGINS=

# Proveedor de LLM para POST /chat. Cualquier API compatible con OpenAI:
# - Gemini directo:  https://generativelanguage.googleapis.com/v1beta/openai
# - Gateway OpenClaw: http://127.0.0.1:18789/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=tu_api_key
# Con Gemini: id del modelo (ej. gemini-flash-latest). Con OpenClaw: openclaw/finanzas_personales
LLM_MODEL=gemini-flash-latest
# Opcional: modelo de respaldo si el principal esta saturado o sin cuota
LLM_FALLBACK_MODEL=gemini-flash-lite-latest
# Segundos maximos de espera de la respuesta del LLM
LLM_TIMEOUT=30
