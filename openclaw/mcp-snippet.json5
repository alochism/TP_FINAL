// Fragmento para openclaw.json (sección mcp). Ajustar rutas.
{
  mcp: {
    servers: {
      finanzas: {
        command: "python",
        args: ["server.py"],
        cwd: "/ruta/a/agent/tools-mcp",
        env: {
          BACKEND_URL: "http://localhost:8000",
          AGENT_USER_EMAIL: "${AGENT_USER_EMAIL}",
          AGENT_USER_PASSWORD: "${AGENT_USER_PASSWORD}",
        },
      },
    },
  },
  // Cerrar el agente a SOLO las tools de finanzas (verificar nombres exactos de grupos en la doc):
  tools: { deny: ["group:runtime", "group:fs", "browser", "canvas"] },
}
