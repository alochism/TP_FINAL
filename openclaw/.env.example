# Variables que usa OpenClaw (copiar a .env, que esta ignorado por git).

# Proveedor de LLM del agente
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=tu_api_key
LLM_MODEL=gemini-2.5-flash

# Usuario de prueba del servidor MCP (solo desarrollo desde la consola de OpenClaw)
AGENT_USER_EMAIL=usuario.prueba@correo.com
AGENT_USER_PASSWORD=clave_de_prueba
